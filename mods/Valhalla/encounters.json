[
  {
    "//": "Adds random survivors visiting the pagan cult to shop during the day",
    "type": "effect_on_condition",
    "id": "EOC_RandEnc_VC_Shoppers_add",
    "recurrence": 3000,
    "global": true,
    "condition": {
      "and": [
        { "u_near_om_location": "pagan_cult_mod_left_corner_up", "range": 30 },
        {
          "not": {
            "u_near_om_location": "pagan_cult_mod_left_corner_up",
            "range": 2
          }
        },
        "is_day",
        { "one_in_chance": 10 },
        {
          "math": ["time_since(u_timer_VC_Shoppers_RandEnc) >= time('1 d')"]
        }
      ]
    },
    "effect": [
      {
        "mapgen_update": "nest_RandEnc_RC_Shoppers_add",
        "om_terrain": "pagan_cult_mod_left_corner_up"
      },
      {
        "math": ["u_timer_VC_Shoppers_RandEnc = time('now')"]
      },
      {
        "u_location_variable": { "global_val": "randenc_shoppers_loc" },
        "target_params": { "om_terrain": "pagan_cult_mod_left_corner_up" }
      },
      {
        "math": ["VC_Shoppers_visiting = 1"]
      }
    ]
  },
  {
    "//": "Removes visiting survivors after 6 hours or at night",
    "type": "effect_on_condition",
    "id": "EOC_RandEnc_VC_Shoppers_remove",
    "recurrence": 200,
    "global": true,
    "condition": {
      "and": [
        {
          "or": [
            {
              "math": ["time_since(u_timer_VC_Shoppers_RandEnc) >= time('6 h')"]
            },
            "is_night"
          ]
        },
        {
          "math": ["VC_Shoppers_visiting == 1"]
        },
        {
          "not": {
            "u_near_om_location": "pagan_cult_mod_left_corner_up",
            "range": 2
          }
        }
      ]
    },
    "effect": [
      {
        "mapgen_update": "nest_RandEnc_RC_Shoppers_remove",
        "om_terrain": "pagan_cult_mod_left_corner_up",
        "target_var": { "global_val": "randenc_shoppers_loc" }
      },
      {
        "math": ["VC_Shoppers_visiting = 0"]
      }
    ]
  },
  {
    "//": "Places a visiting survivor NPC in the pagan cult's trading area",
    "type": "mapgen",
    "update_mapgen_id": "nest_RandEnc_RC_Shoppers_add",
    "object": {
      "place_npcs": [{ "class": "RC_survivor_visiting", "x": 21, "y": 8 }]
    }
  },
  {
    "//": "Removes the visiting survivor NPC when encounter ends",
    "type": "mapgen",
    "update_mapgen_id": "nest_RandEnc_RC_Shoppers_remove",
    "object": {
      "remove_npcs": [{ "class": "RC_survivor_visiting", "x": 0, "y": 0 }]
    }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_RandEnc_Roadstop_add",
    "recurrence": 1800,
    "global": true,
    "effect": [
      {
        "set_condition": "random_enc_condition",
        "condition": { "and": [{ "not": { "is_season": "winter" } }, "is_day"] }
      },
      {
        "run_eocs": "EOC_RandEnc",
        "variables": {
          "omt": "roadstop_a",
          "map_update": "nest_RandEnc_roadstop_a_add",
          "map_removal": "nest_RandEnc_roadstop_a_remove",
          "chance": 10,
          "days_till_spawn": 7
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_RandEnc_Roadstop_remove",
    "recurrence": 200,
    "global": true,
    "condition": {
      "and": [
        { "math": ["time_since(u_timer_caravan_RandEnc) > time('1 h')"] },
        { "not": { "u_near_om_location": "roadstop_a", "range": 2 } },
        { "math": ["RandEnc_Caravan == 1"] }
      ]
    },
    "effect": [
      {
        "mapgen_update": "nest_RandEnc_roadstop_a_remove",
        "om_terrain": "roadstop_a",
        "target_var": { "global_val": "randenc_caravan_loc" }
      },
      { "math": ["RandEnc_Caravan = 0"] }
    ]
  },
  {
    "type": "mapgen",
    "update_mapgen_id": "nest_RandEnc_roadstop_a_add",
    "//": "Adds a random encounter at this roadstop",
    "object": {
      "place_npcs": [
        { "class": "FM_caravan_merchant_random", "x": 5, "y": 4 },
        { "class": "FM_caravan_guard_A", "x": 4, "y": 1 },
        { "class": "FM_caravan_guard_B", "x": 4, "y": 2 }
      ],
      "place_vehicles": [
        {
          "vehicle": "FM_early_pickup",
          "fuel": 50,
          "faction": "free_merchants",
          "x": [4],
          "y": [1]
        }
      ]
    }
  },
  {
    "type": "mapgen",
    "update_mapgen_id": "nest_RandEnc_roadstop_a_remove",
    "//": "removes a random encounter at this roadstop",
    "object": {
      "remove_npcs": [
        { "class": "FM_caravan_merchant_random", "x": 0, "y": 0 },
        { "class": "FM_caravan_guard_A", "x": 0, "y": 0 },
        { "class": "FM_caravan_guard_B", "x": 0, "y": 0 }
      ],
      "remove_vehicles": [
        { "vehicles": ["FM_early_pickup"], "x": [1, 15], "y": [1, 10] }
      ]
    }
  },
